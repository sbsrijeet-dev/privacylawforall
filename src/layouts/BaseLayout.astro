---
// src/layouts/BaseLayout.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import AdBlockModal from '../components/AdBlockModal.astro';
import AntiScrapeShield from '../components/AntiScrapeShield.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogType?: string;
  image?: string;
  jsonLd?: Record<string, any> | Record<string, any>[];
}

const {
  title = 'PrivacyLawForAll.free — Privacy law, made accessible to all for free, in one place',
  description = 'Free, plain-English explainer articles on landmark privacy law cases, fines, and regulations across EU GDPR, India DPDPA, and the EU AI Act.',
  keywords = 'privacy law, privacy law explained, cipp/e, iapp, gdpr fines, edpb, ico, dpc, cnil, aepd, garante, data protection officer, india dpdpa, eu ai act, landmark privacy cases',
  ogType = 'website',
  image = '/og-image.png',
  jsonLd,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Google Search Console Verification -->
    <meta name="google-site-verification" content="google9f979564ba944c3b" />

    <!-- Search Engine & Snippet Optimization -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="X-Frame-Options" content="SAMEORIGIN" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- OpenGraph / Social -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.site)} />

    <!-- Structured Data JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      'name': 'PrivacyLawForAll.free',
      'alternateName': ['Privacy Law For All', 'PrivacyLawForAll', 'Privacy Law Explained'],
      'url': 'https://privacylawforall.sbsrijeet.workers.dev',
      'description': description,
      'potentialAction': {
        '@type': 'SearchAction',
        'target': 'https://privacylawforall.sbsrijeet.workers.dev/cases?q={search_term_string}',
        'query-input': 'required name=search_term_string'
      }
    })} />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <!-- Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&family=Merriweather:ital,wght@0,300;0,400;0,700;1,300&display=swap" rel="stylesheet">
  </head>
  <body class="min-h-screen flex flex-col selection:bg-red-800 selection:text-white bg-white text-slate-900 font-sans antialiased">
    <!-- Top Bold Italic Disclaimer Banner -->
    <div class="w-full bg-slate-900 text-slate-100 py-2 px-4 text-center border-b border-slate-950 shadow-sm">
      <p class="max-w-6xl mx-auto text-xs sm:text-sm font-bold italic tracking-wide">
        DISCLAIMER: This website is strictly for general informational, educational, and research purposes only. Nothing on this website constitutes legal advice, a formal legal opinion, or an attorney-client relationship.
      </p>
    </div>
    <Header />
    <!-- Creator Support & Open-Access Notice (Static, Zero-JS) -->
    <div class="w-full border-b border-amber-200 bg-amber-50/95 py-2.5 px-4 text-amber-950 shadow-sm">
      <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-start md:items-center justify-between gap-3 text-xs sm:text-sm">
        <div class="flex items-start gap-2.5">
          <span class="text-base sm:text-lg flex-shrink-0 mt-0.5">☕</span>
          <div class="leading-relaxed">
            <span class="font-bold text-amber-900">A Friendly Note from the Creator:</span>
            <em>(If your ad blocker is already off or whitelisted, thank you—you can safely ignore this!)</em>
            If you wish to support PrivacyLawForAll, please consider pausing your ad blocker so standard non-intrusive ads can run. 
            <strong>Don't worry—there are zero pop-up, video, or intrusive ads here</strong>; just standard, quiet ads to keep this research 100% free with no paywalls. If you cannot turn off your ad blocker, you can also support the dev with a small coffee donation at
            <a href="https://buymeacoffee.com/sbsrijeet" target="_blank" rel="noopener noreferrer" class="font-bold underline text-amber-900 hover:text-amber-950">buymeacoffee.com/sbsrijeet</a>. Thank you for your support!
          </div>
        </div>
        <div class="flex items-center gap-2 flex-shrink-0 self-end md:self-auto">
          <a
            href="https://buymeacoffee.com/sbsrijeet"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-md bg-amber-400 hover:bg-amber-500 text-slate-950 px-3 py-1.5 text-xs font-bold shadow-sm transition-colors whitespace-nowrap"
          >
            <span>☕</span>
            <span>Buy Me a Coffee</span>
          </a>
        </div>
      </div>
    </div>
    <main class="flex-grow bg-white">
      <slot />
    </main>
    <CookieBanner />
    <AdBlockModal />
    <AntiScrapeShield />
    <Footer />
  </body>
</html>

