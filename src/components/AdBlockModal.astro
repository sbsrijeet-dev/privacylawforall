---
// src/components/AdBlockModal.astro
// Non-Intrusive Softblock & Friendly Creator Support Banners
---

<!-- Bait element to trigger element-hiding filters -->
<div id="ad-detection-bait" class="adsbox ad-placement adsbygoogle advertisement banner-ad" style="position: absolute; left: -9999px; top: -9999px; width: 1px; height: 1px;" aria-hidden="true"></div>

<!-- Top AdBlock Soft Banner (Inserted right below header when ad blocker is detected) -->
<div
  id="adblock-top-banner"
  class="hidden w-full border-b border-amber-200 bg-amber-50/95 py-3 px-4 text-amber-950 transition-all shadow-sm"
  role="note"
  aria-label="Ad-blocker friendly notice"
>
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-start md:items-center justify-between gap-3 text-xs sm:text-sm">
    <div class="flex items-start gap-2.5">
      <span class="text-base sm:text-lg flex-shrink-0 mt-0.5">☕</span>
      <div class="leading-relaxed">
        <span class="font-bold text-amber-900">A Friendly Note from the Creator:</span>
        <em>(If you already have your ad blocker turned off or whitelisted, you can safely ignore or dismiss this!)</em>
        If you wish to support PrivacyLawForAll, please consider pausing your ad blocker so standard non-intrusive ads can run. 
        <strong>Don't worry—there are zero pop-up, video, or intrusive ads here</strong>; just standard, quiet ads to keep this research 100% free with no paywalls. If you cannot turn off your ad blocker, you can also support the dev with a small coffee donation at
        <a href="https://buymeacoffee.com/sbsrijeet" target="_blank" rel="noopener noreferrer" class="font-bold underline text-amber-900 hover:text-amber-950">buymeacoffee.com/sbsrijeet</a>. Thank you for your support!
      </div>
    </div>
    <div class="flex items-center gap-2 flex-shrink-0 self-end md:self-auto">
      <a
        href="https://buymeacoffee.com/sbsrijeet"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 rounded-md bg-amber-400 hover:bg-amber-500 text-slate-950 px-3 py-1.5 text-xs font-bold shadow-sm transition-colors whitespace-nowrap"
      >
        <span>☕</span>
        <span>Buy Me a Coffee</span>
      </a>
      <button
        type="button"
        id="adblock-dismiss-top-btn"
        class="text-amber-700 hover:text-amber-950 p-1 rounded hover:bg-amber-200/60 transition-colors"
        aria-label="Dismiss banner"
        title="Dismiss notice"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>
</div>

<!-- Bottom AdBlock Soft Banner (Renders above footer, tagged with legacy ID for verification suite) -->
<div
  id="adblock-modal-overlay"
  class="hidden w-full border-t border-amber-200 bg-amber-50/70 py-6 px-4 text-amber-950"
  role="note"
  aria-label="Ad-blocker support reminder"
>
  <div class="max-w-4xl mx-auto rounded-xl border border-amber-200 bg-white p-5 sm:p-6 shadow-sm">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="space-y-1.5">
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-100 text-amber-900 border border-amber-200">
            100% Free & Independent Legal Education
          </span>
        </div>
        <h4 id="adblock-modal-title" class="text-sm sm:text-base font-bold text-slate-900">
          Enjoying this free legal resource? (Ad-Blocker Notice)
        </h4>
        <p class="text-xs sm:text-sm text-slate-700 leading-relaxed max-w-2xl">
          <em>(If your ad blocker is already off or whitelisted, thank you—you can safely ignore this note!)</em> This entire platform is researched and built by a single student. There are no paywalls, no login barriers, and no pop-ups. Standard non-intrusive ads are how the site pays for server hosting, infrastructure, and ongoing case research. If you can whitelist this site or support with a coffee, it keeps this legal library accessible to everyone for free.
        </p>
      </div>
      <div class="flex items-center gap-3 flex-shrink-0 w-full sm:w-auto">
        <a
          href="https://buymeacoffee.com/sbsrijeet"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex justify-center items-center gap-2 rounded-lg bg-amber-400 hover:bg-amber-500 text-slate-950 px-4 py-2.5 text-xs font-bold shadow-sm transition-colors whitespace-nowrap"
        >
          <span>☕</span>
          <span>Support on Buy Me a Coffee</span>
        </a>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    let adBlockDetected = false;

    function showAdBlockSoftBanners() {
      if (adBlockDetected) return;
      adBlockDetected = true;

      // 1. Bottom banner reveal (in-flow, never locks screen or scroll)
      const bottomBanner = document.getElementById('adblock-modal-overlay');
      if (bottomBanner) {
        bottomBanner.classList.remove('hidden');
      }

      // 2. Top banner placement (in-flow directly under header)
      const isDismissed = sessionStorage.getItem('pl_adblock_soft_dismissed') === 'true';
      const topBanner = document.getElementById('adblock-top-banner');
      const header = document.querySelector('header');

      if (topBanner && header && !isDismissed) {
        header.insertAdjacentElement('afterend', topBanner);
        topBanner.classList.remove('hidden');
      }
    }

    document.addEventListener('DOMContentLoaded', function () {
      // Dismiss button handler
      const dismissBtn = document.getElementById('adblock-dismiss-top-btn');
      if (dismissBtn) {
        dismissBtn.addEventListener('click', function () {
          const topBanner = document.getElementById('adblock-top-banner');
          if (topBanner) {
            topBanner.classList.add('hidden');
          }
          try {
            sessionStorage.setItem('pl_adblock_soft_dismissed', 'true');
          } catch (e) {}
        });
      }

      // Test 1: Bait DOM Element check
      setTimeout(function () {
        const bait = document.getElementById('ad-detection-bait');
        if (
          !bait ||
          bait.offsetParent === null ||
          bait.offsetHeight === 0 ||
          bait.offsetLeft === 0 ||
          window.getComputedStyle(bait).display === 'none' ||
          window.getComputedStyle(bait).visibility === 'hidden'
        ) {
          showAdBlockSoftBanners();
          return;
        }

        // Test 2: Network probe against common ad server URL
        const probe = new Request('https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js', {
          method: 'HEAD',
          mode: 'no-cors',
        });

        fetch(probe)
          .then(function (res) {
            if (res && res.status === 0 && !res.ok && res.type !== 'opaque') {
              showAdBlockSoftBanners();
            }
          })
          .catch(function () {
            showAdBlockSoftBanners();
          });
      }, 350);
    });
  })();
</script>

