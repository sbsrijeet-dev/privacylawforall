---
// src/components/AdBlockModal.astro
---

<!-- Bait element to trigger element-hiding filters -->
<div id="ad-detection-bait" class="adsbox ad-placement adsbygoogle advertisement banner-ad" style="position: absolute; left: -9999px; top: -9999px; width: 1px; height: 1px;" aria-hidden="true"></div>

<!-- Unescapable Ad Blocker Modal Overlay -->
<div
  id="adblock-modal-overlay"
  class="fixed inset-0 z-[999999] hidden items-center justify-center bg-black/75 p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="adblock-modal-title"
>
  <div class="relative w-full max-w-lg rounded-xl border border-slate-300 bg-white p-6 sm:p-8 shadow-2xl">
    <!-- Icon & Badge -->
    <div class="flex items-center justify-between">
      <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-amber-100 text-amber-800">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>
      <span class="rounded-full bg-slate-100 border border-slate-200 px-3 py-1 text-xs font-semibold text-slate-700">
        100% Free & Independent
      </span>
    </div>

    <!-- Title -->
    <h2 id="adblock-modal-title" class="mt-5 text-2xl font-bold tracking-tight text-slate-900">
      Ad Blocker Detected
    </h2>

    <p class="mt-2 text-xs font-semibold uppercase tracking-wider text-brand-700">
      "Privacy law, made accessible to all for free, in one place."
    </p>

    <!-- Message Body -->
    <div class="mt-4 space-y-3 text-sm text-slate-700 leading-relaxed">
      <p>
        Hi there. This website is researched, written, and built entirely by a <strong>single person</strong> as an open educational project.
      </p>
      <p>
        <strong>Everything on this site is 100% free:</strong> there are no paywalls, no login barriers, and no paid memberships.
      </p>
      <p class="rounded-lg border border-amber-300 bg-amber-50 p-3.5 text-xs text-amber-950 leading-normal">
        <strong>Why ads matter here:</strong> Standard, non-intrusive ads are my <strong>only source of revenue</strong> to pay for server hosting, web infrastructure, and ongoing case research. Without them, keeping this site free and accessible is not possible.
      </p>
      <p class="text-xs text-slate-500">
        Please consider turning off your ad blocker or whitelisting <strong>PrivacyLawForAll.free</strong> to continue reading.
      </p>
    </div>

    <!-- Action Button (Refresh page after disabling) -->
    <div class="mt-6 flex flex-col gap-2.5 sm:flex-row">
      <button
        id="adblock-refresh-btn"
        type="button"
        class="w-full rounded-lg bg-brand-700 px-5 py-3 text-sm font-bold text-white shadow-sm hover:bg-brand-800 transition-colors text-center"
      >
        I have disabled my ad blocker (Refresh Page)
      </button>
    </div>

    <!-- Instructions helper -->
    <div class="mt-4 border-t border-slate-200 pt-3 text-center">
      <span class="text-[11px] text-slate-500">
        How to whitelist: Click your ad blocker icon in your browser bar &gt; toggle Pause / Whitelist for this site &gt; click Refresh above.
      </span>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    let adBlockDetected = false;

    function showAdBlockModal() {
      if (adBlockDetected) return;
      adBlockDetected = true;

      const overlay = document.getElementById('adblock-modal-overlay');
      if (overlay) {
        overlay.classList.remove('hidden');
        overlay.classList.add('flex');

        // Block scrolling on the page
        document.documentElement.style.overflow = 'hidden';
        document.body.style.overflow = 'hidden';

        // Block escape key
        window.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' || e.keyCode === 27) {
            e.preventDefault();
            e.stopPropagation();
            return false;
          }
        }, true);
      }
    }

    // Refresh handler
    document.addEventListener('DOMContentLoaded', function () {
      const refreshBtn = document.getElementById('adblock-refresh-btn');
      refreshBtn?.addEventListener('click', function () {
        window.location.reload();
      });

      // Test 1: Bait DOM Element check
      setTimeout(function () {
        const bait = document.getElementById('ad-detection-bait');
        if (
          !bait ||
          bait.offsetParent === null ||
          bait.offsetHeight === 0 ||
          bait.offsetLeft === 0 ||
          window.getComputedStyle(bait).display === 'none' ||
          window.getComputedStyle(bait).visibility === 'hidden'
        ) {
          showAdBlockModal();
          return;
        }

        // Test 2: Network probe against common ad server URL
        const probe = new Request('https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js', {
          method: 'HEAD',
          mode: 'no-cors',
        });

        fetch(probe)
          .then(function (res) {
            // Check if blocked by response status
            if (res && res.status === 0 && !res.ok && res.type !== 'opaque') {
              showAdBlockModal();
            }
          })
          .catch(function () {
            // Network request was blocked by ad blocker
            showAdBlockModal();
          });
      }, 350);
    });
  })();
</script>
