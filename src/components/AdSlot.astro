---
// src/components/AdSlot.astro
interface Props {
  slotId?: string;
  format?: 'horizontal' | 'rectangle' | 'vertical';
  className?: string;
}

const { slotId = 'default-ad-slot', format = 'horizontal', className = '' } = Astro.props;

let heightClass = 'h-24 sm:h-28';
if (format === 'rectangle') heightClass = 'h-64 max-w-sm';
if (format === 'vertical') heightClass = 'h-96 w-60';
---

<div class={`my-8 overflow-hidden rounded-xl border border-dashed border-slate-300 bg-slate-50/50 p-2 text-center ${className}`}>
  <div class="flex items-center justify-between px-2 pb-1.5 text-[10px] uppercase tracking-wider text-slate-500">
    <span>Sponsored Placement</span>
    <span>Supports Free Open-Access Guides</span>
  </div>

  <div class={`flex w-full ${heightClass} items-center justify-center rounded-lg border border-slate-200 bg-white shadow-inner`}>
    <!-- Google AdSense Container -->
    <!-- When pub-id is configured, inject <ins class="adsbygoogle" ... /> here -->
    <div class="flex flex-col items-center justify-center space-y-1 p-3 text-slate-500">
      <svg class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" />
      </svg>
      <span class="text-xs font-medium text-slate-600">Google AdSense Partner Placement</span>
      <span class="text-[10px] text-slate-400">Slot ID: {slotId} • Responsive Placement</span>
    </div>
  </div>
</div>
