---
// src/components/FactBadge.astro
interface Props {
  dpa: string;
  country: string;
  fine: string;
  articles: string[];
  jurisdiction: string;
  verified?: boolean;
}

const { dpa, country, fine, articles, jurisdiction, verified = true } = Astro.props;
---

<div class="rounded border border-slate-200 bg-slate-50 p-4 shadow-sm">
  <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 pb-3">
    <div class="flex items-center gap-2">
      <span class="inline-flex items-center gap-1 rounded bg-emerald-100 border border-emerald-300 px-2 py-0.5 text-xs font-semibold text-emerald-900">
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
        </svg>
        Fact-Checked & Verified
      </span>
      <span class="text-xs text-slate-600 font-medium">
        {country} • {jurisdiction}
      </span>
    </div>

    <!-- Fine Amount Display -->
    <div class="text-right">
      <span class="text-[10px] uppercase font-bold tracking-wider text-slate-500 block">Sanction / Fine</span>
      <span class="text-base font-extrabold text-red-700">{fine}</span>
    </div>
  </div>

  <div class="mt-3 grid grid-cols-1 gap-2 text-xs sm:grid-cols-2">
    <div>
      <span class="text-slate-500 font-medium">Issuing Authority:</span>
      <span class="ml-1 font-semibold text-slate-900">{dpa}</span>
    </div>
    <div>
      <span class="text-slate-500 font-medium">Articles Cited:</span>
      <div class="mt-1 flex flex-wrap gap-1">
        {articles.map((art) => (
          <span class="rounded bg-white border border-slate-200 px-1.5 py-0.5 font-mono text-[11px] font-semibold text-slate-800">
            {art}
          </span>
        ))}
      </div>
    </div>
  </div>
</div>

