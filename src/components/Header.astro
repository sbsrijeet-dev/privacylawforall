---
// src/components/Header.astro
const pathname = new URL(Astro.request.url).pathname;
---

<header class="sticky top-0 z-40 w-full border-b border-slate-200 bg-white">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Brand Logo & Motto -->
    <div class="flex items-center gap-3">
      <a href="/" class="group flex items-center gap-2.5">
        <div class="flex h-9 w-9 items-center justify-center rounded bg-red-900 text-white shadow-sm group-hover:bg-red-950 transition-colors">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        </div>
        <div>
          <span class="text-lg font-bold tracking-tight text-slate-900 group-hover:text-red-900 transition-colors">
            PrivacyLawForAll<span class="text-red-900">.free</span>
          </span>
          <p class="hidden text-[10px] uppercase font-semibold tracking-wider text-slate-500 sm:block">
            Privacy Law, Accessible To All For Free, In One Place
          </p>
        </div>
      </a>
    </div>

    <!-- Desktop Navigation -->
    <nav class="hidden items-center gap-1 md:flex">
      <a
        href="/top-5"
        class={`rounded px-3 py-1.5 text-sm font-semibold transition-colors ${
          pathname.startsWith('/top-5')
            ? 'bg-amber-100 text-amber-900 border border-amber-300'
            : 'text-slate-700 hover:bg-slate-100 hover:text-slate-900'
        }`}
      >
        <span class="inline-flex items-center gap-1.5">
          <span class="h-2 w-2 rounded-full bg-amber-600"></span>
          Top 5 Fines
        </span>
      </a>

      <a
        href="/cases"
        class={`rounded px-3 py-1.5 text-sm font-medium transition-colors ${
          pathname.startsWith('/cases')
            ? 'bg-red-50 text-red-900 font-semibold border border-red-200'
            : 'text-slate-700 hover:bg-slate-100 hover:text-slate-900'
        }`}
      >
        All Cases
      </a>

      <a
        href="/categories"
        class={`rounded px-3 py-1.5 text-sm font-medium transition-colors ${
          pathname.startsWith('/categories')
            ? 'bg-red-50 text-red-900 font-semibold border border-red-200'
            : 'text-slate-700 hover:bg-slate-100 hover:text-slate-900'
        }`}
      >
        Categories
      </a>

      <a
        href="/compliance-mistakes"
        class={`rounded px-3 py-1.5 text-sm font-medium transition-colors ${
          pathname.startsWith('/compliance-mistakes')
            ? 'bg-red-50 text-red-900 font-semibold border border-red-200'
            : 'text-slate-700 hover:bg-slate-100 hover:text-slate-900'
        }`}
      >
        Mistakes Guide
      </a>

      <!-- GDPR & Countries Dropdown -->
      <div class="relative group">
        <a
          href="/gdpr"
          class={`flex items-center gap-1 rounded px-3 py-1.5 text-sm font-medium transition-colors ${
            pathname.startsWith('/gdpr')
              ? 'bg-red-50 text-red-900 font-semibold border border-red-200'
              : 'text-slate-700 hover:bg-slate-100 hover:text-slate-900'
          }`}
        >
          EU GDPR
          <svg class="h-4 w-4 transition-transform group-hover:rotate-180 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </a>
        <div class="absolute left-0 top-full hidden w-64 pt-2 group-hover:block z-50">
          <div class="rounded border border-slate-200 bg-white p-2 shadow-lg">
            <a href="/gdpr" class="block rounded px-3 py-2 text-xs font-semibold uppercase text-red-900 hover:bg-red-50">
              Overview & 7 Principles
            </a>
            <a href="/gdpr/articles" class="block rounded px-3 py-2 text-xs font-semibold text-slate-800 hover:bg-slate-100">
              Statutory Articles Guide (20 Key Articles)
            </a>
            <div class="my-1 border-t border-slate-200"></div>
            <a href="/gdpr/spain" class="flex items-center justify-between rounded px-3 py-1.5 text-sm text-slate-700 hover:bg-slate-100">
              <span>Spain</span> <span class="text-xs text-slate-500 font-medium">AEPD</span>
            </a>
            <a href="/gdpr/france" class="flex items-center justify-between rounded px-3 py-1.5 text-sm text-slate-700 hover:bg-slate-100">
              <span>France</span> <span class="text-xs text-slate-500 font-medium">CNIL</span>
            </a>
            <a href="/gdpr/ireland" class="flex items-center justify-between rounded px-3 py-1.5 text-sm text-slate-700 hover:bg-slate-100">
              <span>Ireland</span> <span class="text-xs text-slate-500 font-medium">DPC</span>
            </a>
            <a href="/gdpr/italy" class="flex items-center justify-between rounded px-3 py-1.5 text-sm text-slate-700 hover:bg-slate-100">
              <span>Italy</span> <span class="text-xs text-slate-500 font-medium">Garante</span>
            </a>
            <a href="/gdpr/uk" class="flex items-center justify-between rounded px-3 py-1.5 text-sm text-slate-700 hover:bg-slate-100">
              <span>UK</span> <span class="text-xs text-slate-500 font-medium">ICO</span>
            </a>
          </div>
        </div>
      </div>

      <a
        href="/dpdpa"
        class={`rounded px-3 py-1.5 text-sm font-medium transition-colors ${
          pathname.startsWith('/dpdpa')
            ? 'bg-red-50 text-red-900 font-semibold border border-red-200'
            : 'text-slate-700 hover:bg-slate-100 hover:text-slate-900'
        }`}
      >
        India DPDPA
      </a>

      <a
        href="/eu-ai-act"
        class={`rounded px-3 py-1.5 text-sm font-medium transition-colors ${
          pathname.startsWith('/eu-ai-act')
            ? 'bg-red-50 text-red-900 font-semibold border border-red-200'
            : 'text-slate-700 hover:bg-slate-100 hover:text-slate-900'
        }`}
      >
        EU AI Act
      </a>
    </nav>

    <!-- Right: Mobile Menu Button -->
    <div class="flex items-center gap-2">
      <button
        id="mobile-menu-button"
        type="button"
        aria-label="Open navigation menu"
        class="inline-flex h-9 w-9 items-center justify-center rounded border border-slate-300 bg-white text-slate-700 md:hidden hover:bg-slate-100"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation drawer -->
  <div id="mobile-menu" class="hidden border-b border-slate-200 bg-white px-4 py-3 md:hidden">
    <div class="flex flex-col space-y-2">
      <a href="/top-5" class="rounded px-3 py-2 text-sm font-semibold text-amber-900 bg-amber-100 border border-amber-300">Top 5 Fines</a>
      <a href="/cases" class="rounded px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100">All Cases</a>
      <a href="/categories" class="rounded px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100">Thematic Categories</a>
      <a href="/compliance-mistakes" class="rounded px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100">10 Compliance Mistakes</a>
      <a href="/gdpr" class="rounded px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100">EU GDPR Hub</a>
      <div class="pl-4 space-y-1 text-xs text-slate-600">
        <a href="/gdpr/articles" class="block py-1 hover:text-red-900 font-medium">Statutory Articles Directory</a>
        <a href="/gdpr/spain" class="block py-1 hover:text-red-900">Spain (AEPD)</a>
        <a href="/gdpr/france" class="block py-1 hover:text-red-900">France (CNIL)</a>
        <a href="/gdpr/ireland" class="block py-1 hover:text-red-900">Ireland (DPC)</a>
        <a href="/gdpr/italy" class="block py-1 hover:text-red-900">Italy (Garante)</a>
        <a href="/gdpr/uk" class="block py-1 hover:text-red-900">UK (ICO)</a>
      </div>
      <a href="/dpdpa" class="rounded px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100">India DPDPA</a>
      <a href="/eu-ai-act" class="rounded px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100">EU AI Act</a>
    </div>
  </div>
</header>

<script is:inline>
  // Mobile menu toggle
  const mobileMenuBtn = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  mobileMenuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>

