---
// src/pages/categories/index.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import { CATEGORIES } from '../../utils/categories';

const allCases = await getCollection('cases');

// Calculate case counts per category
const categoriesWithCounts = CATEGORIES.map((cat) => {
  const matchingCases = allCases.filter((c) => c.data.category === cat.slug);
  return {
    ...cat,
    count: matchingCases.length,
    cases: matchingCases,
  };
});
---

<BaseLayout
  title="Thematic Categories Directory | PrivacyLaw.free"
  description="Explore landmark privacy law decisions grouped by domain: AI & Biometrics, AdTech & Cookies, Telemarketing Spam, Cybersecurity Breaches, Children's Privacy, and Cross-Border Transfers."
>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 bg-white">
    <!-- Breadcrumbs -->
    <nav class="mb-6 flex items-center space-x-2 text-xs text-slate-500">
      <a href="/" class="hover:text-red-900">Home</a>
      <span>/</span>
      <span class="text-slate-900 font-medium">Categories</span>
    </nav>

    <!-- Header -->
    <div class="max-w-3xl">
      <span class="inline-flex items-center gap-1.5 rounded border border-slate-300 bg-slate-50 px-3 py-1 text-xs font-bold text-slate-700">
        Thematic Reference Hubs
      </span>
      <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
        Case Explainers by Thematic Category
      </h1>
      <p class="mt-4 text-base text-slate-600 leading-relaxed">
        Rather than reading purely by country, explore how data protection authorities across Europe, the UK, and globally enforce specific technical practices. Select a category below to explore verified case breakdowns, penalty precedents, and compliance red lines.
      </p>
    </div>

    <!-- Ad Placement Top -->
    <AdSlot slotId="categories-index-top" format="horizontal" />

    <!-- Categories Grid -->
    <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {categoriesWithCounts.map((cat) => (
        <a
          href={`/categories/${cat.slug}`}
          class="group flex flex-col justify-between rounded-lg border border-slate-200 bg-white p-6 shadow-sm hover:border-red-900 hover:shadow-md transition-all"
        >
          <div>
            <div class="flex items-center justify-between">
              <span class="text-3xl">{cat.icon}</span>
              <span class="rounded-full bg-slate-100 border border-slate-200 px-2.5 py-0.5 text-xs font-bold text-slate-700">
                {cat.count} {cat.count === 1 ? 'Case' : 'Cases'}
              </span>
            </div>

            <h2 class="mt-4 text-lg font-bold text-slate-900 group-hover:text-red-900 transition-colors">
              {cat.name}
            </h2>

            <p class="mt-2 text-xs text-slate-600 leading-relaxed">
              {cat.description}
            </p>
          </div>

          <div class="mt-6 border-t border-slate-100 pt-3">
            <span class="block text-[11px] font-semibold text-slate-500 uppercase tracking-wider">
              {cat.examDomain}
            </span>
            <span class="mt-2 inline-flex items-center text-xs font-bold text-red-900 group-hover:underline">
              Explore Collection ({cat.count}) →
            </span>
          </div>
        </a>
      ))}
    </div>

    <!-- Banner to Compliance Mistakes -->
    <div class="mt-14 rounded-xl border border-red-200 bg-red-50/50 p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-red-900">Flagship Practical Guide</span>
        <h3 class="text-lg font-bold text-slate-900 mt-1">10 Most Common Compliance Mistakes</h3>
        <p class="text-xs text-slate-600 mt-1 max-w-xl leading-relaxed">
          From unvetted M&A software to asymmetric cookie refusal dark patterns, explore the 10 most catastrophic pitfalls that trigger multi-million-euro penalties.
        </p>
      </div>
      <a
        href="/compliance-mistakes"
        class="shrink-0 rounded-lg bg-red-900 px-4 py-2.5 text-xs font-bold text-white shadow hover:bg-red-950 transition-colors"
      >
        Read Compliance Guide →
      </a>
    </div>

    <!-- Ad Placement Bottom -->
    <AdSlot slotId="categories-index-bottom" format="horizontal" />
  </div>
</BaseLayout>
