---
// src/pages/gdpr/germany.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseCard from '../../components/CaseCard.astro';
import AdSlot from '../../components/AdSlot.astro';

const allCases = await getCollection('cases');
const germanyCases = allCases.filter((c) => c.data.country === 'Germany');
---

<BaseLayout
  title="Germany GDPR Enforcement Hub (BfDI, DSK & State DPAs) | Employee Privacy & Data Retention"
  description="Master Germany's unique GDPR regime: the dual supervisory structure (BfDI + 16 State DPAs under DSK), BDSG § 26 employee privacy, tenant archive concepts, and landmark enforcement decisions."
>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 bg-white">
    <!-- Breadcrumbs -->
    <nav class="mb-6 flex items-center space-x-2 text-xs text-slate-500">
      <a href="/" class="hover:text-red-900">Home</a>
      <span>/</span>
      <a href="/gdpr" class="hover:text-red-900">EU GDPR</a>
      <span>/</span>
      <span class="text-slate-900 font-medium">Germany (BfDI & DSK)</span>
    </nav>

    <!-- Header -->
    <div class="max-w-3xl">
      <div class="flex items-center gap-3">
        <span class="text-4xl">🇩🇪</span>
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-red-900">
            National Enforcement Hub
          </span>
          <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
            Germany: BfDI, State DPAs & DSK Precedent
          </h1>
        </div>
      </div>
      <p class="mt-4 text-base text-slate-600 leading-relaxed">
        Germany operates the most decentralized data protection framework in the European Union. Supervision is divided between the <strong>Federal Commissioner for Data Protection and Freedom of Information (BfDI)</strong> (regulating federal bodies and telecommunications) and <strong>16 independent State Supervisory Authorities (Landesdatenschutzbehörden)</strong>. These regulators assemble in the <strong>Datenschutzkonferenz (DSK)</strong> to issue unified statutory guidance, setting gold-standard legal precedents across the continent.
      </p>
    </div>

    <!-- Ad Placement Top -->
    <AdSlot slotId="germany-hub-top" format="horizontal" />

    <!-- German Dual Structure & Statutory Context -->
    <div class="mt-8 rounded-lg border border-slate-200 bg-slate-50 p-6 shadow-sm">
      <h2 class="text-lg font-bold text-slate-900">The German Regulatory Architecture: BDSG & The DSK</h2>
      <div class="mt-3 grid grid-cols-1 md:grid-cols-3 gap-6 text-xs text-slate-700 leading-relaxed">
        <div>
          <span class="font-bold text-slate-900 block mb-1">Dual Federal & State DPAs</span>
          While the BfDI oversees postal and telecommunications providers (such as 1&1 Telecom), private sector companies are supervised by state commissioners like Hamburg (HmbBfDI), Berlin (BlnBDI), Lower Saxony (LfD), and Baden-Württemberg (LfDI).
        </div>
        <div>
          <span class="font-bold text-slate-900 block mb-1">§ 26 BDSG: Employee Privacy</span>
          Germany utilizes GDPR Article 88's opening clause via Section 26 of the Federal Data Protection Act (BDSG). Employee monitoring, call recording, and personal life profiling face the strictest scrutiny in Europe (demonstrated in H&M's €35.3M fine).
        </div>
        <div>
          <span class="font-bold text-slate-900 block mb-1">Mandatory Deletion Concepts</span>
          German DPAs demand formal technical archive and deletion concepts (<em>Löschkonzept</em>). Storing legacy customer or tenant data without automated tiering and purging violates Article 25 by Design (Deutsche Wohnen's €14.5M sanction).
        </div>
      </div>
    </div>

    <!-- Core Characteristics of German Enforcement -->
    <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="rounded border border-slate-200 bg-white p-6 shadow-sm">
        <div class="font-bold text-slate-900 text-base">Workplace Surveillance Ban</div>
        <p class="mt-2 text-xs text-slate-600 leading-relaxed">
          German regulators strictly prohibit continuous employee surveillance. Notebooksbilliger's 2-year camera logging and H&M's private life dossiers established that general suspicion never justifies pervasive monitoring.
        </p>
      </div>

      <div class="rounded border border-slate-200 bg-white p-6 shadow-sm">
        <div class="font-bold text-slate-900 text-base">Architectural Privacy-by-Design</div>
        <p class="mt-2 text-xs text-slate-600 leading-relaxed">
          Berlin's action against Deutsche Wohnen established that holding data in monolithic, un-deletable legacy databases is an inherent structural violation of GDPR Article 25(1) and Article 5(1)(e).
        </p>
      </div>

      <div class="rounded border border-slate-200 bg-white p-6 shadow-sm">
        <div class="font-bold text-slate-900 text-base">Technical Security & Remediation</div>
        <p class="mt-2 text-xs text-slate-600 leading-relaxed">
          Baden-Württemberg's Knuddels precedent demonstrated that rapid self-reporting, transparent cooperation, and hashing upgrades significantly mitigate penalties, while BfDI's 1&1 case mandated multi-factor call-center authentication.
        </p>
      </div>
    </div>

    <!-- Cases List -->
    <div class="mt-12">
      <div class="border-b border-slate-200 pb-3 flex items-center justify-between">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">
          Landmark Decisions from Germany ({germanyCases.length})
        </h2>
        <span class="text-xs font-semibold text-red-900 bg-red-50 border border-red-200 px-2.5 py-1 rounded">
          All Cases Verified Against Official DPA Records
        </span>
      </div>
      <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {germanyCases.map((entry) => (
          <CaseCard
            title={entry.data.title}
            slug={entry.slug}
            dpa={entry.data.dpa}
            country={entry.data.country}
            fine={entry.data.fine_amount}
            articles={entry.data.articles_cited}
            tldr={entry.data.tldr}
            jurisdiction={entry.data.jurisdiction}
            category={entry.data.category}
            isTop5={entry.data.is_top_5}
            top5Rank={entry.data.top_5_rank}
          />
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
