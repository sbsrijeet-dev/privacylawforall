---
// src/pages/gdpr/france.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseCard from '../../components/CaseCard.astro';
import AdSlot from '../../components/AdSlot.astro';

const allCases = await getCollection('cases');
const franceCases = allCases.filter((c) => c.data.country === 'France');
---

<BaseLayout
  title="France GDPR Enforcement Hub (CNIL) | Cookie Walls, AdTech & Biometrics"
  description="Explore the French CNIL's landmark enforcement actions: cookie refusal dark patterns, ePrivacy investigations, facial recognition bans, and adtech audits."
>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 bg-white">
    <!-- Breadcrumbs -->
    <nav class="mb-6 flex items-center space-x-2 text-xs text-slate-500">
      <a href="/" class="hover:text-red-900">Home</a>
      <span>/</span>
      <a href="/gdpr" class="hover:text-red-900">EU GDPR</a>
      <span>/</span>
      <span class="text-slate-900 font-medium">France (CNIL)</span>
    </nav>

    <!-- Header -->
    <div class="max-w-3xl">
      <div class="flex items-center gap-3">
        <span class="text-4xl">🇫🇷</span>
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-red-900">
            National Enforcement Hub
          </span>
          <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
            France: CNIL Enforcement & Precedent
          </h1>
        </div>
      </div>
      <p class="mt-4 text-base text-slate-600 leading-relaxed">
        The <strong>Commission Nationale de l'Informatique et des Libertés (CNIL)</strong> is Europe's premier intellectual powerhouse on digital tracking, cookies, and emerging technologies. The CNIL established the revolutionary principle of <em>"Asymmetry of Effort"</em>—ruling that rejecting cookies must be as fast and easy as accepting them with a single click.
      </p>
    </div>

    <!-- Ad Placement Top -->
    <AdSlot slotId="france-hub-top" format="horizontal" />

    <!-- Core Characteristics of French Enforcement -->
    <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="rounded border border-slate-200 bg-white p-6 shadow-sm">
        <div class="font-bold text-slate-900 text-base">Direct ePrivacy Action</div>
        <p class="mt-2 text-xs text-slate-600 leading-relaxed">
          The CNIL frequently issues fines against tech giants under the ePrivacy Directive (Article 82 French Data Protection Act), bypassing the slow GDPR One-Stop-Shop mechanism.
        </p>
      </div>

      <div class="rounded border border-slate-200 bg-white p-6 shadow-sm">
        <div class="font-bold text-slate-900 text-base">Cookie Dark Patterns Ban</div>
        <p class="mt-2 text-xs text-slate-600 leading-relaxed">
          Banners offering "Accept All" with one click while burying "Reject All" under settings menus have resulted in hundreds of millions in fines for Google, Facebook, and Microsoft.
        </p>
      </div>

      <div class="rounded border border-slate-200 bg-white p-6 shadow-sm">
        <div class="font-bold text-slate-900 text-base">AdTech & Retention Enforcement</div>
        <p class="mt-2 text-xs text-slate-600 leading-relaxed">
          The CNIL strictly inspects behavioral retargeters like Criteo and retail databases like Carrefour, enforcing strict retention caps and independent proof of consent.
        </p>
      </div>
    </div>

    <!-- Cases List -->
    <div class="mt-12">
      <div class="border-b border-slate-200 pb-3">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">
          Explained Decisions from France (CNIL) ({franceCases.length})
        </h2>
      </div>
      <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {franceCases.map((entry) => (
          <CaseCard
            title={entry.data.title}
            slug={entry.slug}
            dpa={entry.data.dpa}
            country={entry.data.country}
            fine={entry.data.fine_amount}
            articles={entry.data.articles_cited}
            tldr={entry.data.tldr}
            jurisdiction={entry.data.jurisdiction}
            category={entry.data.category}
            isTop5={entry.data.is_top_5}
            top5Rank={entry.data.top_5_rank}
          />
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

