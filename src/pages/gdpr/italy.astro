---
// src/pages/gdpr/italy.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseCard from '../../components/CaseCard.astro';
import AdSlot from '../../components/AdSlot.astro';

const allCases = await getCollection('cases');
const italyCases = allCases.filter((c) => c.data.country === 'Italy');
---

<BaseLayout
  title="Italy GDPR Enforcement Hub (Garante) | AI Governance & Telemarketing"
  description="Explore the Italian Garante's landmark decisions: the ChatGPT temporary ban, AI training data scrutiny, energy telemarketing fines, and biometric enforcement."
>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 bg-white">
    <!-- Breadcrumbs -->
    <nav class="mb-6 flex items-center space-x-2 text-xs text-slate-500">
      <a href="/" class="hover:text-red-900">Home</a>
      <span>/</span>
      <a href="/gdpr" class="hover:text-red-900">EU GDPR</a>
      <span>/</span>
      <span class="text-slate-900 font-medium">Italy (Garante)</span>
    </nav>

    <!-- Header -->
    <div class="max-w-3xl">
      <div class="flex items-center gap-3">
        <span class="text-4xl">🇮🇹</span>
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-red-900">
            National Enforcement Hub
          </span>
          <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
            Italy: Garante Enforcement & Precedent
          </h1>
        </div>
      </div>
      <p class="mt-4 text-base text-slate-600 leading-relaxed">
        The <strong>Garante per la Protezione dei Dati Personali</strong> is Europe's boldest regulator when addressing cutting-edge artificial intelligence and aggressive consumer marketing. In 2023, the Garante set a global precedent by ordering a temporary nationwide block of OpenAI's ChatGPT over web-scraping training data and lack of age gates.
      </p>
    </div>

    <!-- Ad Placement Top -->
    <AdSlot slotId="italy-hub-top" format="horizontal" />

    <!-- Core Characteristics of Italian Enforcement -->
    <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="rounded border border-slate-200 bg-white p-6 shadow-sm">
        <div class="font-bold text-slate-900 text-base">Global Leader in AI Scrutiny</div>
        <p class="mt-2 text-xs text-slate-600 leading-relaxed">
          The Garante was the first Western regulator to directly apply GDPR principles (lawful basis, transparency, accuracy, and right to object) to generative LLMs.
        </p>
      </div>

      <div class="rounded border border-slate-200 bg-white p-6 shadow-sm">
        <div class="font-bold text-slate-900 text-base">Multi-Million Energy & Telco Fines</div>
        <p class="mt-2 text-xs text-slate-600 leading-relaxed">
          Italy has levied major multi-million penalties (TIM €27.8M, Enel Energia €26.5M) against enterprises relying on rogue telemarketing call centers and illicit lead lists.
        </p>
      </div>

      <div class="rounded border border-slate-200 bg-white p-6 shadow-sm">
        <div class="font-bold text-slate-900 text-base">Biometrics & Facial Recognition</div>
        <p class="mt-2 text-xs text-slate-600 leading-relaxed">
          The Garante actively sanctions municipal and private deployments of smart cameras and facial recognition systems that lack specific legislative authorization.
        </p>
      </div>
    </div>

    <!-- Cases List -->
    <div class="mt-12">
      <div class="border-b border-slate-200 pb-3">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">
          Explained Decisions from Italy (Garante) ({italyCases.length})
        </h2>
      </div>
      <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {italyCases.map((entry) => (
          <CaseCard
            title={entry.data.title}
            slug={entry.slug}
            dpa={entry.data.dpa}
            country={entry.data.country}
            fine={entry.data.fine_amount}
            articles={entry.data.articles_cited}
            tldr={entry.data.tldr}
            jurisdiction={entry.data.jurisdiction}
            category={entry.data.category}
            isTop5={entry.data.is_top_5}
            top5Rank={entry.data.top_5_rank}
          />
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

