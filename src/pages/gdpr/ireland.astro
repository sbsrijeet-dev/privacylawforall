---
// src/pages/gdpr/ireland.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseCard from '../../components/CaseCard.astro';
import AdSlot from '../../components/AdSlot.astro';

const allCases = await getCollection('cases');
const irelandCases = allCases.filter((c) => c.data.country === 'Ireland');
---

<BaseLayout
  title="Ireland GDPR Enforcement Hub (DPC) | Big Tech Fines & One-Stop-Shop"
  description="Explore the Irish Data Protection Commission (DPC) enforcement record: Meta €1.2B, Instagram €405M, TikTok €345M, WhatsApp €225M, and cross-border cross-EU decisions."
>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 bg-white">
    <!-- Breadcrumbs -->
    <nav class="mb-6 flex items-center space-x-2 text-xs text-slate-500">
      <a href="/" class="hover:text-red-900">Home</a>
      <span>/</span>
      <a href="/gdpr" class="hover:text-red-900">EU GDPR</a>
      <span>/</span>
      <span class="text-slate-900 font-medium">Ireland (DPC)</span>
    </nav>

    <!-- Header -->
    <div class="max-w-3xl">
      <div class="flex items-center gap-3">
        <span class="text-4xl">🇮🇪</span>
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-red-900">
            National Enforcement Hub
          </span>
          <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
            Ireland: DPC Enforcement & Big Tech
          </h1>
        </div>
      </div>
      <p class="mt-4 text-base text-slate-600 leading-relaxed">
        Because Silicon Valley giants like Meta, Google, Apple, Microsoft, and TikTok chose Dublin as their European Main Establishment, the <strong>Data Protection Commission (DPC)</strong> acts as Europe's Lead Supervisory Authority under the GDPR "One-Stop-Shop" mechanism. Four of the five largest fines in GDPR history were issued by the DPC.
      </p>
    </div>

    <!-- Ad Placement Top -->
    <AdSlot slotId="ireland-hub-top" format="horizontal" />

    <!-- Big Tech Enforcement Statistics -->
    <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="rounded border border-slate-200 bg-white p-6 shadow-sm">
        <div class="font-bold text-slate-900 text-base">One-Stop-Shop Epicenter</div>
        <p class="mt-2 text-xs text-slate-600 leading-relaxed">
          Under Article 56 GDPR, any cross-border processing by Dublin-based multinational tech companies must be investigated primarily through the Irish DPC.
        </p>
      </div>

      <div class="rounded border border-slate-200 bg-white p-6 shadow-sm">
        <div class="font-bold text-slate-900 text-base">Billions in Cumulative Fines</div>
        <p class="mt-2 text-xs text-slate-600 leading-relaxed">
          The Irish DPC has levied over €2.5 Billion in fines against Meta alone across five separate inquiries covering transfers, consent contracts, and teenage data.
        </p>
      </div>

      <div class="rounded border border-slate-200 bg-white p-6 shadow-sm">
        <div class="font-bold text-slate-900 text-base">Article 65 Escalations</div>
        <p class="mt-2 text-xs text-slate-600 leading-relaxed">
          Irish draft decisions frequently trigger peer review and formal disputes from German, French, and Italian DPAs, culminating in binding EDPB orders.
        </p>
      </div>
    </div>

    <!-- Cases List -->
    <div class="mt-12">
      <div class="border-b border-slate-200 pb-3">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">
          Explained Decisions from Ireland (DPC) ({irelandCases.length})
        </h2>
      </div>
      <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {irelandCases.map((entry) => (
          <CaseCard
            title={entry.data.title}
            slug={entry.slug}
            dpa={entry.data.dpa}
            country={entry.data.country}
            fine={entry.data.fine_amount}
            articles={entry.data.articles_cited}
            tldr={entry.data.tldr}
            jurisdiction={entry.data.jurisdiction}
            category={entry.data.category}
            isTop5={entry.data.is_top_5}
            top5Rank={entry.data.top_5_rank}
          />
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

