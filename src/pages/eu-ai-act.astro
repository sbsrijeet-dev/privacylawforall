---
// src/pages/eu-ai-act.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseCard from '../components/CaseCard.astro';
import AdSlot from '../components/AdSlot.astro';

const allCases = await getCollection('cases');
const aiCases = allCases.filter((c) => c.data.jurisdiction === 'EU AI ACT' || c.data.category.includes('AI'));
---

<BaseLayout
  title="EU AI Act Explained | Risk Tiers, Prohibited AI & €35M Penalties"
  description="Master the European Union Artificial Intelligence Act (Regulation 2024/1689). Plain-English guide to prohibited AI, High-Risk compliance, and 7% global turnover fines."
>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 bg-white">
    <!-- Hero -->
    <div class="max-w-3xl">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center px-2.5 py-1 rounded font-mono font-bold text-xs bg-slate-100 text-slate-800 border border-slate-200">
          EU AI
        </span>
        <span class="inline-flex items-center rounded border border-indigo-200 bg-indigo-50 px-3 py-1 text-xs font-semibold text-indigo-950">
          Global AI Benchmark Regulation
        </span>
      </div>
      <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl">
        The EU AI Act Explained in Plain English
      </h1>
      <p class="mt-4 text-base text-slate-600 sm:text-lg leading-relaxed">
        The European Union Artificial Intelligence Act (Regulation (EU) 2024/1689) is the world's first comprehensive, binding horizontal regulation on AI. With penalties reaching <strong>€35 Million or 7% of global turnover</strong>, here is how the risk-based system works.
      </p>
    </div>

    <!-- Ad Placement Top -->
    <AdSlot slotId="ai-act-hub-top" format="horizontal" />

    <!-- The 4 Risk Tiers -->
    <div class="mt-12">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">
        The 4-Tier Risk Classification Pyramid
      </h2>
      <p class="mt-2 text-sm text-slate-600 max-w-2xl">
        The AI Act regulates algorithms based on the risk they pose to human health, safety, and fundamental rights:
      </p>

      <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Tier 1: Unacceptable -->
        <div class="rounded border border-rose-300 bg-rose-50/50 p-6">
          <div class="flex items-center justify-between">
            <span class="rounded bg-rose-700 px-3 py-1 text-xs font-bold text-white uppercase tracking-wider">
              1. Unacceptable Risk
            </span>
            <span class="text-xs font-bold text-rose-800">Strictly Prohibited</span>
          </div>
          <h3 class="mt-4 text-base font-bold text-slate-900">
            Banned AI Practices (Article 5)
          </h3>
          <p class="mt-2 text-xs text-slate-600 leading-relaxed">
            Systems completely outlawed in the EU: untargeted facial image scraping, social scoring, subliminal behavioral manipulation causing harm, predictive policing based purely on personality traits, and emotion recognition at work or school.
          </p>
          <div class="mt-4 text-xs font-bold text-rose-800">
            Penalty: Up to €35M or 7% of global turnover
          </div>
        </div>

        <!-- Tier 2: High Risk -->
        <div class="rounded border border-amber-300 bg-amber-50/50 p-6">
          <div class="flex items-center justify-between">
            <span class="rounded bg-amber-700 px-3 py-1 text-xs font-bold text-white uppercase tracking-wider">
              2. High-Risk AI
            </span>
            <span class="text-xs font-bold text-amber-800">Heavily Regulated</span>
          </div>
          <h3 class="mt-4 text-base font-bold text-slate-900">
            Critical Applications (Annex III)
          </h3>
          <p class="mt-2 text-xs text-slate-600 leading-relaxed">
            AI used in CV/resume screening, hiring, credit scoring, welfare eligibility, law enforcement, and critical infrastructure. Permitted only after passing strict conformity assessments, bias audits, risk logging, and human oversight.
          </p>
          <div class="mt-4 text-xs font-bold text-amber-800">
            Penalty: Up to €15M or 3% of global turnover
          </div>
        </div>

        <!-- Tier 3: Limited Risk -->
        <div class="rounded border border-blue-300 bg-blue-50/50 p-6">
          <div class="flex items-center justify-between">
            <span class="rounded bg-blue-700 px-3 py-1 text-xs font-bold text-white uppercase tracking-wider">
              3. Specific Transparency
            </span>
            <span class="text-xs font-bold text-blue-800">Disclosure Required</span>
          </div>
          <h3 class="mt-4 text-base font-bold text-slate-900">
            Chatbots & Deepfakes (Article 50)
          </h3>
          <p class="mt-2 text-xs text-slate-600 leading-relaxed">
            Users must be explicitly informed when interacting with an AI system (like customer service bots). Audio, video, and image synthetic media (deepfakes) must be machine-readably marked and watermarked as AI-generated.
          </p>
          <div class="mt-4 text-xs font-bold text-blue-800">
            Obligation: Clear disclosure and watermarking
          </div>
        </div>

        <!-- Tier 4: Minimal Risk -->
        <div class="rounded border border-emerald-300 bg-emerald-50/50 p-6">
          <div class="flex items-center justify-between">
            <span class="rounded bg-emerald-700 px-3 py-1 text-xs font-bold text-white uppercase tracking-wider">
              4. Minimal Risk
            </span>
            <span class="text-xs font-bold text-emerald-800">Freely Permitted</span>
          </div>
          <h3 class="mt-4 text-base font-bold text-slate-900">
            Everyday AI Applications
          </h3>
          <p class="mt-2 text-xs text-slate-600 leading-relaxed">
            AI spam filters, video game recommendation engines, and inventory optimization tools pose zero or minimal risk to human rights and may be deployed across the EU without mandatory compliance paperwork.
          </p>
          <div class="mt-4 text-xs font-bold text-emerald-800">
            Standard: Voluntary codes of conduct
          </div>
        </div>
      </div>
    </div>

    <!-- AI Cases Section -->
    <div class="mt-14">
      <div class="border-b border-slate-200 pb-3">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">
          Featured AI Governance & Scraping Decisions ({aiCases.length})
        </h2>
      </div>
      <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {aiCases.map((entry) => (
          <CaseCard
            title={entry.data.title}
            slug={entry.slug}
            dpa={entry.data.dpa}
            country={entry.data.country}
            fine={entry.data.fine_amount}
            articles={entry.data.articles_cited}
            tldr={entry.data.tldr}
            jurisdiction={entry.data.jurisdiction}
            category={entry.data.category}
            isTop5={entry.data.is_top_5}
            top5Rank={entry.data.top_5_rank}
          />
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

