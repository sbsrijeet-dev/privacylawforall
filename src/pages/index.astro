---
// src/pages/index.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseCard from '../components/CaseCard.astro';
import AdSlot from '../components/AdSlot.astro';

const allCases = await getCollection('cases');

// Featured cases: Top 5 cases + latest
const top5Cases = allCases
  .filter((c) => c.data.is_top_5 && c.data.top_5_rank)
  .sort((a, b) => (a.data.top_5_rank || 0) - (b.data.top_5_rank || 0))
  .slice(0, 3);

const recentCases = allCases
  .filter((c) => !c.data.is_top_5)
  .slice(0, 6);
---

<BaseLayout
  title="PrivacyLawForAll.free — Privacy law, made accessible to all for free, in one place"
  description="A free, no-login, no-paywall explainer blog breaking down landmark privacy law cases, fines, and regulations across EU GDPR, India DPDPA, and the EU AI Act."
>
  <!-- Hero Section -->
  <section class="border-b border-slate-200 bg-white px-4 py-14 sm:px-6 sm:py-18 lg:px-8">
    <div class="mx-auto max-w-5xl text-center">
      <!-- Motto Badge -->
      <div class="inline-flex items-center gap-2 rounded border border-slate-300 bg-slate-50 px-3.5 py-1 text-xs font-semibold text-slate-700">
        <span class="flex h-2 w-2 rounded-full bg-red-900"></span>
        No Login • No Paywall • Free Forever
      </div>

      <!-- Main Motto Headline -->
      <h1 class="mt-5 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl leading-tight">
        Privacy law, made <span class="text-red-900 underline decoration-red-900/30">accessible to all</span> for free, in one place.
      </h1>

      <p class="mx-auto mt-4 max-w-2xl text-base text-slate-600 sm:text-lg leading-relaxed">
        Understand high-stakes privacy cases, multi-million-euro fines, and emerging AI regulations in <strong>plain, jargon-free English</strong>. Every factual claim is programmatically cross-verified against official regulatory records.
      </p>

      <!-- Quick Action Buttons -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/top-5"
          class="rounded bg-red-900 px-5 py-2.5 text-sm font-bold text-white hover:bg-red-950 transition-colors shadow-sm"
        >
          Top 5 Biggest Fines
        </a>
        <a
          href="/cases"
          class="rounded border border-slate-300 bg-white px-5 py-2.5 text-sm font-bold text-slate-800 hover:bg-slate-50 transition-colors"
        >
          Browse All Cases
        </a>
      </div>

      <!-- Key Platform Statistics (Interactive Cards) -->
      <div class="mt-12 grid grid-cols-2 gap-3 sm:grid-cols-4 max-w-3xl mx-auto pt-6 border-t border-slate-200">
        <a
          href="/cases"
          class="group block rounded-lg border border-slate-200 bg-slate-50/50 p-3 hover:border-slate-300 hover:bg-slate-100/70 transition-all text-center"
          title="Browse all landmark cases"
        >
          <div class="text-2xl sm:text-3xl font-bold text-slate-900 group-hover:text-red-900 transition-colors">
            {allCases.length}
          </div>
          <div class="text-[11px] text-slate-600 font-semibold mt-1 group-hover:text-slate-900 transition-colors flex items-center justify-center gap-1">
            <span>Landmark Cases</span>
            <span class="text-slate-400 group-hover:text-red-900 transition-colors text-[10px]">→</span>
          </div>
        </a>

        <a
          href="/top-5"
          class="group block rounded-lg border border-slate-200 bg-slate-50/50 p-3 hover:border-amber-300 hover:bg-amber-50/40 transition-all text-center"
          title="View the Top 5 Biggest GDPR Fines"
        >
          <div class="text-2xl sm:text-3xl font-bold text-red-900 group-hover:text-red-950 transition-colors">
            €2.92B+
          </div>
          <div class="text-[11px] text-slate-600 font-semibold mt-1 group-hover:text-slate-900 transition-colors flex items-center justify-center gap-1">
            <span>Top 5 Fines Tracked</span>
            <span class="text-slate-400 group-hover:text-red-900 transition-colors text-[10px]">→</span>
          </div>
        </a>

        <a
          href="#frameworks"
          class="group block rounded-lg border border-slate-200 bg-slate-50/50 p-3 hover:border-slate-300 hover:bg-slate-100/70 transition-all text-center"
          title="Explore Global Privacy Frameworks"
        >
          <div class="text-2xl sm:text-3xl font-bold text-slate-900 group-hover:text-red-900 transition-colors">
            3
          </div>
          <div class="text-[11px] text-slate-600 font-semibold mt-1 group-hover:text-slate-900 transition-colors flex items-center justify-center gap-1">
            <span>Privacy Frameworks</span>
            <span class="text-slate-400 group-hover:text-red-900 transition-colors text-[10px]">↓</span>
          </div>
        </a>

        <a
          href="/gdpr/articles"
          class="group block rounded-lg border border-slate-200 bg-slate-50/50 p-3 hover:border-slate-300 hover:bg-slate-100/70 transition-all text-center"
          title="Explore 20 Statutory GDPR Articles"
        >
          <div class="text-2xl sm:text-3xl font-bold text-slate-900 group-hover:text-red-900 transition-colors">
            20
          </div>
          <div class="text-[11px] text-slate-600 font-semibold mt-1 group-hover:text-slate-900 transition-colors flex items-center justify-center gap-1">
            <span>Statutory Articles</span>
            <span class="text-slate-400 group-hover:text-red-900 transition-colors text-[10px]">→</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 space-y-14 bg-white">
    <!-- Top Ad Placement -->
    <AdSlot slotId="home-leaderboard" format="horizontal" />

    <!-- Landmark Top 5 Banner Showcase -->
    <div class="rounded border border-slate-200 bg-slate-50 p-8 shadow-sm">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div class="space-y-2">
          <span class="inline-flex items-center gap-1.5 rounded bg-amber-100 border border-amber-300 px-2.5 py-0.5 text-xs font-bold text-amber-900">
            ★ Historic Enforcement Milestones
          </span>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">
            The Top 5 Biggest GDPR Fines in History
          </h2>
          <p class="text-sm text-slate-600 max-w-xl leading-relaxed">
            Meta (€1.2B), Amazon (€746M), Instagram (€405M), TikTok (€345M), and WhatsApp (€225M). See the full breakdown of how each tech giant got caught and what rules they violated.
          </p>
        </div>
        <a
          href="/top-5"
          class="shrink-0 rounded bg-red-900 px-6 py-3 text-sm font-bold text-white hover:bg-red-950 transition-colors text-center"
        >
          View The Top 5 →
        </a>
      </div>

      <!-- Top 3 Preview Grid -->
      <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-4">
        {top5Cases.map((c) => (
          <a
            href={`/cases/${c.slug}`}
            class="group rounded border border-slate-200 bg-white p-5 shadow-sm hover:border-red-900 transition-all"
          >
            <div class="flex items-center justify-between">
              <span class="flex h-6 w-6 items-center justify-center rounded bg-amber-600 text-white font-bold text-xs">
                #{c.data.top_5_rank}
              </span>
              <span class="font-extrabold text-xs text-red-700">
                {c.data.fine_amount}
              </span>
            </div>
            <h3 class="mt-3 text-sm font-bold text-slate-900 group-hover:text-red-900 transition-colors">
              {c.data.popular_name}
            </h3>
            <p class="mt-2 text-xs text-slate-600 line-clamp-2 leading-relaxed">
              {c.data.tldr}
            </p>
          </a>
        ))}
      </div>
    </div>

    <!-- Jurisdiction Hubs Exploration Grid -->
    <div id="frameworks" class="scroll-mt-20">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">
          Explore by Jurisdiction & Framework
        </h2>
        <p class="text-sm text-slate-600 mt-1">
          Navigate statutory principles, national DPAs, and landmark rulings across major regions:
        </p>
      </div>

      <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <!-- EU GDPR -->
        <a
          href="/gdpr"
          class="group rounded border border-slate-200 bg-white p-6 shadow-sm hover:border-red-900 transition-all"
        >
          <span class="inline-flex items-center px-2.5 py-1 rounded font-mono font-bold text-xs bg-slate-100 text-slate-800 border border-slate-200 group-hover:border-red-800 group-hover:bg-red-50 group-hover:text-red-900 transition-all">
            EU
          </span>
          <h3 class="mt-3 text-lg font-bold text-slate-900 group-hover:text-red-900 transition-colors">
            European Union GDPR Hub
          </h3>
          <p class="mt-2 text-xs text-slate-600 leading-relaxed">
            The complete guide to the 7 core principles (Article 5), 6 lawful bases (Article 6), and national hubs for Spain, France, Ireland, Italy, and the UK.
          </p>
          <div class="mt-4 text-xs font-semibold text-red-900">
            Explore EU GDPR →
          </div>
        </a>

        <!-- India DPDPA -->
        <a
          href="/dpdpa"
          class="group rounded border border-slate-200 bg-white p-6 shadow-sm hover:border-red-900 transition-all"
        >
          <span class="inline-flex items-center px-2.5 py-1 rounded font-mono font-bold text-xs bg-slate-100 text-slate-800 border border-slate-200 group-hover:border-red-800 group-hover:bg-red-50 group-hover:text-red-900 transition-all">
            IN
          </span>
          <h3 class="mt-3 text-lg font-bold text-slate-900 group-hover:text-red-900 transition-colors">
            India DPDPA 2023 Hub
          </h3>
          <p class="mt-2 text-xs text-slate-600 leading-relaxed">
            Master the Digital Personal Data Protection Act: Consent Managers, Significant Data Fiduciaries, child data bans, and ₹250 Crore penalties.
          </p>
          <div class="mt-4 text-xs font-semibold text-red-900">
            Explore India DPDPA →
          </div>
        </a>

        <!-- EU AI Act -->
        <a
          href="/eu-ai-act"
          class="group rounded border border-slate-200 bg-white p-6 shadow-sm hover:border-red-900 transition-all"
        >
          <span class="inline-flex items-center px-2.5 py-1 rounded font-mono font-bold text-xs bg-slate-100 text-slate-800 border border-slate-200 group-hover:border-red-800 group-hover:bg-red-50 group-hover:text-red-900 transition-all">
            EU AI
          </span>
          <h3 class="mt-3 text-lg font-bold text-slate-900 group-hover:text-red-900 transition-colors">
            EU AI Act Hub
          </h3>
          <p class="mt-2 text-xs text-slate-600 leading-relaxed">
            Understand the world's first comprehensive AI regulation: the 4-tier risk classification, prohibited AI, and up to 7% global revenue fines.
          </p>
          <div class="mt-4 text-xs font-semibold text-red-900">
            Explore EU AI Act →
          </div>
        </a>
      </div>
    </div>

    <!-- Latest Explained Cases -->
    <div>
      <div class="flex items-center justify-between border-b border-slate-200 pb-3">
        <div>
          <h2 class="text-2xl font-bold tracking-tight text-slate-900">
            Recent Case Explainers
          </h2>
          <p class="text-sm text-slate-600 mt-1">
            Freshly verified plain-English breakdowns of regulatory decisions:
          </p>
        </div>
        <a href="/cases" class="text-xs font-bold text-red-900 hover:underline">
          View All ({allCases.length}) →
        </a>
      </div>

      <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {recentCases.map((entry) => (
          <CaseCard
            title={entry.data.title}
            slug={entry.slug}
            dpa={entry.data.dpa}
            country={entry.data.country}
            fine={entry.data.fine_amount}
            articles={entry.data.articles_cited}
            tldr={entry.data.tldr}
            jurisdiction={entry.data.jurisdiction}
            category={entry.data.category}
            isTop5={entry.data.is_top_5}
            top5Rank={entry.data.top_5_rank}
          />
        ))}
      </div>
    </div>

    <!-- Mid Page Ad Placement -->
    <AdSlot slotId="home-bottom-placement" format="horizontal" />
  </div>
</BaseLayout>
