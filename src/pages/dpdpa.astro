---
// src/pages/dpdpa.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseCard from '../components/CaseCard.astro';
import AdSlot from '../components/AdSlot.astro';

const allCases = await getCollection('cases');
const dpdpaCases = allCases.filter((c) => c.data.jurisdiction === 'DPDPA');
---

<BaseLayout
  title="India DPDPA 2023 Explained | Consent Managers, SDFs & Fines"
  description="Master India's Digital Personal Data Protection Act (DPDPA 2023). Plain-English guide to Consent Managers, Significant Data Fiduciaries, and ₹250 Crore penalties."
>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 bg-white">
    <!-- Hero -->
    <div class="max-w-3xl">
      <div class="flex items-center gap-2">
        <span class="text-3xl">🇮🇳</span>
        <span class="inline-flex items-center rounded border border-orange-300 bg-orange-50 px-3 py-1 text-xs font-semibold text-orange-950">
          Asian Privacy Legislation
        </span>
      </div>
      <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl">
        India's DPDPA 2023 Explained in Plain English
      </h1>
      <p class="mt-4 text-base text-slate-600 sm:text-lg leading-relaxed">
        The Digital Personal Data Protection Act, 2023 marks a monumental shift in how 1.4 billion people's digital personal data is governed. Built around radical simplicity and heavy penalties of up to <strong>₹250 Crore</strong>, here is how India's law operates.
      </p>
    </div>

    <!-- Ad Placement Top -->
    <AdSlot slotId="dpdpa-hub-top" format="horizontal" />

    <!-- 4 Pillar Concepts of DPDPA -->
    <div class="mt-12">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">
        The 4 Core Pillars of India's Data Architecture
      </h2>

      <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="rounded border border-slate-200 bg-white p-6 shadow-sm">
          <div class="flex items-center gap-2">
            <span class="flex h-7 w-7 items-center justify-center rounded bg-orange-600 text-white font-bold text-xs">1</span>
            <h3 class="font-bold text-slate-900 text-base">Consent is King (Section 6)</h3>
          </div>
          <p class="mt-3 text-xs text-slate-600 leading-relaxed">
            Unlike Europe's GDPR which provides alternative legal grounds like "legitimate interest" or "contractual necessity", DPDPA processes commercial personal data almost exclusively based on <strong>free, specific, informed, and unambiguous consent</strong>. Notices must be available in English or any of the 22 languages specified in the Indian Constitution.
          </p>
        </div>

        <div class="rounded border border-slate-200 bg-white p-6 shadow-sm">
          <div class="flex items-center gap-2">
            <span class="flex h-7 w-7 items-center justify-center rounded bg-orange-600 text-white font-bold text-xs">2</span>
            <h3 class="font-bold text-slate-900 text-base">Consent Managers Framework</h3>
          </div>
          <p class="mt-3 text-xs text-slate-600 leading-relaxed">
            India introduces statutory, registered <strong>Consent Managers</strong>—interoperable platforms acting as a single point of contact where citizens can view, manage, and withdraw consent across multiple businesses, apps, and banks in one interface.
          </p>
        </div>

        <div class="rounded border border-slate-200 bg-white p-6 shadow-sm">
          <div class="flex items-center gap-2">
            <span class="flex h-7 w-7 items-center justify-center rounded bg-orange-600 text-white font-bold text-xs">3</span>
            <h3 class="font-bold text-slate-900 text-base">Strict Ban on Child Tracking (Section 9)</h3>
          </div>
          <p class="mt-3 text-xs text-slate-600 leading-relaxed">
            Companies are <strong>strictly prohibited from undertaking tracking or behavioral monitoring of children</strong> (under 18) or directing targeted ads at minors. Processing that harms a child carries a maximum penalty of up to ₹200 Crore.
          </p>
        </div>

        <div class="rounded border border-slate-200 bg-white p-6 shadow-sm">
          <div class="flex items-center gap-2">
            <span class="flex h-7 w-7 items-center justify-center rounded bg-orange-600 text-white font-bold text-xs">4</span>
            <h3 class="font-bold text-slate-900 text-base">Significant Data Fiduciaries (SDF)</h3>
          </div>
          <p class="mt-3 text-xs text-slate-600 leading-relaxed">
            Large platforms handling high volumes of sensitive data are classified by the Central Government as SDFs. They must appoint a resident Indian Data Protection Officer (DPO), engage independent auditors, and perform mandatory Data Protection Impact Assessments (DPIAs).
          </p>
        </div>
      </div>
    </div>

    <!-- DPDPA Statutory Penalties Table -->
    <div class="mt-14 rounded border border-slate-200 bg-slate-50 p-8 sm:p-10">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">
        DPDPA 2023 Penalty Schedule (The Schedule)
      </h2>
      <p class="mt-2 text-sm text-slate-600">
        Fines are decided by the Data Protection Board of India (DPBI) based on the nature, gravity, duration, and financial gain of the breach:
      </p>

      <div class="mt-6 overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse bg-white">
          <thead>
            <tr class="border-b border-slate-200 text-slate-500 uppercase tracking-wider font-bold">
              <th class="py-3 px-4">Breach Type</th>
              <th class="py-3 px-4">Violated Section</th>
              <th class="py-3 px-4 text-right">Maximum Penalty</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            <tr>
              <td class="py-3.5 px-4 font-semibold text-slate-900">Failure to take reasonable security safeguards to prevent personal data breach</td>
              <td class="py-3.5 px-4 font-mono text-slate-700">Section 8(5)</td>
              <td class="py-3.5 px-4 font-extrabold text-red-700 text-right text-sm">Up to ₹250 Crore</td>
            </tr>
            <tr>
              <td class="py-3.5 px-4 font-semibold text-slate-900">Failure to notify the Board and affected Data Principals of a breach</td>
              <td class="py-3.5 px-4 font-mono text-slate-700">Section 8(6)</td>
              <td class="py-3.5 px-4 font-extrabold text-red-700 text-right text-sm">Up to ₹200 Crore</td>
            </tr>
            <tr>
              <td class="py-3.5 px-4 font-semibold text-slate-900">Breach in observance of additional obligations in relation to children</td>
              <td class="py-3.5 px-4 font-mono text-slate-700">Section 9</td>
              <td class="py-3.5 px-4 font-extrabold text-red-700 text-right text-sm">Up to ₹200 Crore</td>
            </tr>
            <tr>
              <td class="py-3.5 px-4 font-semibold text-slate-900">Breach of additional obligations of Significant Data Fiduciaries (SDF)</td>
              <td class="py-3.5 px-4 font-mono text-slate-700">Section 10</td>
              <td class="py-3.5 px-4 font-extrabold text-red-700 text-right text-sm">Up to ₹150 Crore</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- DPDPA Articles Section -->
    <div class="mt-14">
      <div class="border-b border-slate-200 pb-3">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">
          Featured India DPDPA Explainers ({dpdpaCases.length})
        </h2>
      </div>
      <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {dpdpaCases.map((entry) => (
          <CaseCard
            title={entry.data.title}
            slug={entry.slug}
            dpa={entry.data.dpa}
            country={entry.data.country}
            fine={entry.data.fine_amount}
            articles={entry.data.articles_cited}
            tldr={entry.data.tldr}
            jurisdiction={entry.data.jurisdiction}
            category={entry.data.category}
            isTop5={entry.data.is_top_5}
            top5Rank={entry.data.top_5_rank}
          />
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

